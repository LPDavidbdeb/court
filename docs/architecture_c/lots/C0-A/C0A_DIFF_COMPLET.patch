+        self.assertEqual(LibraryNode.objects.count(), avant)
+        self.assertEqual(NoeudArchive.objects.count(), 0)
+        self.assertEqual(ConfirmationAppui.objects.get(pk=conf.pk).version_examinee.texte,
+                         "texte initial")
