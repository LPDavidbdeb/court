+# Le retrait en cours, propre à chaque fil : deux suppressions concurrentes ne
+# partagent pas leurs attentes.
+_retrait = threading.local()
+
+
+def _etat_archive(noeud):
+    """Ce que l'archive a consigné de l'occurrence : son retrait doit porter sur le même état."""
+    return (noeud.document_id, noeud.path, noeud.item, noeud.paragraph_number,
+            noeud.content_type_id, noeud.object_id)
+
+
+class retrait_controle:
+    """
+    Le retrait ORM d'une occurrence d'un bloc contrôlé ne porte que sur elle,
+    dans l'état où elle a été contrôlée et archivée.
+
+    Le temps du bloc `with`, la garde `pre_delete` de `LibraryNode` refuse, avant
+    qu'aucune ligne ne soit retirée, toute autre occurrence que le collecteur
+    emporterait (un descendant rattaché depuis le contrôle, par exemple), et
+    l'occurrence attendue elle-même si elle a changé depuis (document, chemin,
+    intitulé, numéro ou contenu désigné). Elle consigne dans `retires` l'identité
+    effectivement retirée. L'appelant vérifie ensuite que ce relevé est
+    exactement l'occurrence attendue : une occurrence déjà absente ne produit
+    aucun retrait, et rien ne compense son absence.
+    """
+
+    def __init__(self, noeud):
+        self.attendu = noeud.pk
+        self.etat = _etat_archive(noeud)
+        self.retires = []
+
+    def __enter__(self):
+        self._prec = getattr(_retrait, 'courant', None)
+        _retrait.courant = self
+        return self
+
+    def __exit__(self, *a):
+        _retrait.courant = self._prec
+        return False
+
+
