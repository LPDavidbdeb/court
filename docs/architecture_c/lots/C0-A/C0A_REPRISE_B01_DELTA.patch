+    def _remplacer_pendant_la_suppression(self, contenu_tardif):
+        """
+        B01 (revue indépendante de B, 21 octobre) — remplacement concurrent à
+        effectif constant.
+
+        T1 précontrôle P, E1, E2. Avant sa première archive, T2 (autre connexion,
+        validée aussitôt) retire E1 par le service habituel et ajoute sous P une
+        occurrence E3 que T1 n'a ni contrôlée ni archivée. Un contrôle par effectif
+        (0 + 1 + 2 = 3) laissait T1 retirer E3 sans archive. Attendu : refus de T1,
+        annulation totale de ses écritures, conservation de tout ce que T2 a validé.
+        """
+        parent, e1, e2 = self._bloc()
+        t2 = {}
+
+        def remplacer():
+            svc.supprimer_occurrence(LibraryNode.objects.get(pk=e1.pk), motif="retrait par T2")
+            contenu = contenu_tardif()
+            e3 = LibraryNode.objects.get(pk=parent.pk).add_child(
+                document=self.cible, item="enfant non contrôlé par T1", content_object=contenu)
+            t2.update(e3=e3.pk, contenu=(type(contenu), contenu.pk))
+        motif = self._supprimer_avec_intercalage(parent, remplacer)
+        # refusé sur l'identité : E1, contrôlée et archivée par T1, n'existait plus
+        self.assertIn(f"l'occurrence {e1.pk}, contrôlée et archivée, n'existait plus", motif)
+
+        # T1 n'a rien retiré ni archivé
+        self.assertEqual(set(LibraryNode.objects.filter(
+            pk__in=[parent.pk, e2.pk, t2['e3']]).values_list('pk', flat=True)),
+            {parent.pk, e2.pk, t2['e3']})
+        self.assertEqual(list(NoeudArchive.objects.values_list('noeud_pk', 'motif')),
