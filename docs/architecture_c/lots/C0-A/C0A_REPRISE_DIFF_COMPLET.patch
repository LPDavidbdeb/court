+class C0ARepriseUC15Lecture(BaseCotes):
+    """C15:T01 à T08, T11 et T12."""
+
+    def setUp(self):
+        super().setUp()
+        self.schema = schema_acte()
+        self.source = faire_document("version source", schema=self.schema)
+        self.cible = faire_document("version cible", schema=self.schema)
+        self.rs, self.rc = racine_de(self.source), racine_de(self.cible)
+        self.nc = ajouter(self.rc, self.cible, "1", "le texte cible")
+        self.p5 = entree("P-5", un_evenement("pièce cinq", self.d2015), rang=5)
+        self.p7 = entree("P-7", un_evenement("pièce sept", self.d2015), rang=7)
+
+    def _origine(self, document, parent, item, piece):
+        n = ajouter(parent, document, item, f"origine {item}")
+        AppuiDepotJuillet.objects.create(statement=n.content_object, entree=piece,
+                                         cote_citee=piece.cote)
+        return n
+
+    def _lire(self):
+        return svc.appuis_dorigine(self.nc, document_source=self.source,
+                                   document_cible=self.cible)
+
+    def _origines_mixtes(self):
+        """Une correspondance : deux origines valides et une origine par anomalie."""
+        from document_manager.models import ExtremiteCorrespondance, RoleExtremite
+        from document_manager.test_e01_numerotation import _citations_synthetiques
+        from email_manager.models import Quote as EmailQuote
+        ct = ContentType.objects.get_for_model
+        v1 = self._origine(self.source, self.rs, "v1", self.p5)
+        v2 = self._origine(self.source, self.rs, "v2", self.p7)
+        archivee = self._origine(self.source, self.rs, "arch", self.p5)
+        structure = self.rs.add_child(document=self.source, item="groupe")
+        self._origine(self.source, LibraryNode.objects.get(pk=structure.pk), "sous", self.p7)
+        herite, certifiee = _citations_synthetiques()
+        q_herite = self.rs.add_child(document=self.source, item="qh",
+                                     content_type=ct(EmailQuote), object_id=herite.pk)
+        q_phrase = self.rs.add_child(document=self.source, item="qp",
+                                     content_type=ct(EmailQuote), object_id=certifiee.pk)
+        # un Event dont la PK est celle d'un Statement muni d'un appui
+        homonyme = Statement.objects.create(pk=990001, text="Statement homonyme")
+        AppuiDepotJuillet.objects.create(statement=homonyme, entree=self.p5, cote_citee="P-5")
+        Event.objects.create(pk=990001, date=self.d2015, explanation="Event homonyme")
+        n_event = self.rs.add_child(document=self.source, item="ev",
+                                    content_type=ct(Event), object_id=990001)
+        disparu = self.rs.add_child(document=self.source, item="disparu",
+                                    content_type=ct(Statement), object_id=990002)
+        partielle = self.rs.add_child(document=self.source, item="partielle",
+                                      content_type=ct(Statement), object_id=None)
+        noeuds = [LibraryNode.objects.get(pk=n.pk) for n in
+                  (v1, v2, archivee, structure, q_herite, q_phrase, n_event, disparu, partielle)]
+        corr = svc.relier(self.source, self.cible, noeuds, [self.nc])
+        etranger_doc = faire_document("document étranger", schema=self.schema)
+        etranger = self._origine(etranger_doc, racine_de(etranger_doc), "étranger", self.p7)
+        e_etranger = ExtremiteCorrespondance.objects.create(
+            correspondance=corr, role=RoleExtremite.SOURCE, noeud=etranger, ordre=20)
+        e_absente = ExtremiteCorrespondance.objects.create(
+            correspondance=corr, role=RoleExtremite.SOURCE, noeud=None, ordre=21)
+        ext = {e.noeud_id: e.pk for e in corr.extremites.filter(role=RoleExtremite.SOURCE)}
+        svc.supprimer_occurrence(LibraryNode.objects.get(pk=archivee.pk))
+        anomalies = {
+            ext[archivee.pk]: svc.ORIGINE_ARCHIVEE_NON_ATTESTEE,
+            ext[q_herite.pk]: svc.TYPE_NON_PRIS_EN_CHARGE,
+            ext[q_phrase.pk]: svc.TYPE_NON_PRIS_EN_CHARGE,
+            ext[n_event.pk]: svc.TYPE_NON_PRIS_EN_CHARGE,
+            ext[disparu.pk]: svc.OBJET_INTROUVABLE,
+            ext[partielle.pk]: svc.CLE_GENERIQUE_INCOHERENTE,
+            e_etranger.pk: svc.DOCUMENT_SOURCE_INCOHERENT,
+            e_absente.pk: svc.ORIGINE_ABSENTE,
+        }
+        valides = {(ext[v1.pk], self.p5.pk), (ext[v2.pk], self.p7.pk)}
+        return corr, anomalies, valides
+
+    def _etat_historique(self):
+        from document_manager.models import (
+            Correspondance, ExtremiteCorrespondance, NoeudArchive)
+        return {
+            'correspondances': sorted(Correspondance.objects.values_list(
+                'pk', 'etat', 'traitement', 'decide_le')),
+            'extremites': sorted(ExtremiteCorrespondance.objects.values_list(
+                'pk', 'noeud_id', 'archive_id', 'ordre')),
+            'archives': sorted(NoeudArchive.objects.values_list('pk', 'statement_pk', 'texte')),
+            'confirmations': sorted(ConfirmationAppui.objects.values_list('pk', flat=True)),
+            'captures': sorted(VersionTexte.objects.values_list('pk', flat=True)),
+            'appuis': sorted(AppuiDepotJuillet.objects.values_list('pk', flat=True)),
+            'statements': sorted(Statement.objects.values_list('pk', 'text')),
+            'noeuds': sorted(LibraryNode.objects.values_list('pk', flat=True)),
+        }
+
+    def test_appuis_valides_et_chaque_anomalie_identifies_dans_tous_les_ordres(self):
+        import random
+        from document_manager.models import ExtremiteCorrespondance, RoleExtremite
+        corr, anomalies, valides = self._origines_mixtes()
+        extremites = list(corr.extremites.filter(role=RoleExtremite.SOURCE).order_by('pk'))
+        rangs = list(range(len(extremites)))
+        ordres = [rangs, list(reversed(rangs))]
+        alea = random.Random(20261020)
+        for _ in range(6):
+            o = list(rangs)
+            alea.shuffle(o)
+            ordres.append(o)
+        for ordre in ordres:
+            with self.subTest(ordre=ordre):
+                for e, rang in zip(extremites, ordre):
+                    ExtremiteCorrespondance.objects.filter(pk=e.pk).update(ordre=rang)
+                lecture = self._lire()
+                self.assertEqual({(a['extremite'], a['entree'].pk)
+                                  for a in lecture.appuis_valides}, valides)
+                self.assertEqual(len(lecture.appuis_valides), len(valides))
+                self.assertEqual({d.extremite: d.code for d in lecture.anomalies}, anomalies)
+                self.assertEqual(len(lecture.anomalies), len(anomalies))
+                self.assertFalse(lecture.lecture_complete)
+                for a in lecture.appuis_valides:
+                    self.assertEqual(a['correspondance'], corr.pk)
+                    self.assertIn("VERSION SOURCE", a['origine'])
+                for d in lecture.anomalies:
+                    self.assertEqual((d.correspondance, d.document_source, d.document_cible),
+                                     (corr.pk, self.source.pk, self.cible.pk))
+
+    def test_deux_couples_avec_un_statement_commun_restent_distincts(self):
