+def _citations_synthetiques():
+    """Une citation HERITE et une citation PHRASE certifiée, sur un courriel inventé."""
+    from datetime import datetime
+    from django.utils import timezone
+    from core.quote_regime import create_phrase_quote
+    from email_manager.models import Email, EmailThread
+    from email_manager.models import Quote as EmailQuote
+    from protagonist_manager.models import Protagonist
+    phrase = "Une phrase synthétique."
+    auteur = Protagonist.objects.create(first_name="Témoin", last_name="Synthétique", role="Témoin")
+    fil = EmailThread.objects.create(thread_id="c0a-reprise", subject="Fil", protagonist=auteur)
+    courriel = Email.objects.create(
+        thread=fil, message_id="c0a-reprise-1", subject="Sujet", sender="x@example.test",
+        sender_protagonist=auteur, date_sent=timezone.make_aware(datetime(2015, 4, 20, 9, 0)),
+        dao_source="gmail", eml_file_path="c0a-reprise-1.eml",
+        body_plain_text=phrase + " Une autre phrase synthétique.")
+    herite = EmailQuote.objects.create(email=courriel, quote_text=phrase)
+    certifiee = create_phrase_quote(courriel, 0, len(phrase), derived_from=herite)
+    return herite, certifiee
