+    def _panne_http(self, parent, contexte):
+        avant = self._etat()
+        with contexte:
+            r = self._post("delete", parent)
+        self.assertEqual((r.status_code, r.json()['status']), (500, 'error'),
+                         "aucun succès trompeur")
+        self.assertEqual(self._etat(), avant)
