+        n1 = ajouter(self.rs, self.source, "c", "", statement=commun)
+        n2 = ajouter(racine_de(autre_source), autre_source, "c", "", statement=commun)
+        c1 = svc.relier(self.source, self.cible, [n1], [self.nc])
+        c2 = svc.relier(autre_source, self.cible, [n2], [self.nc])
+        l1 = self._lire()
+        l2 = svc.appuis_dorigine(self.nc, document_source=autre_source,
+                                 document_cible=self.cible)
+        self.assertEqual([(a['correspondance'], a['antecedent'].pk) for a in l1.appuis_valides],
+                         [(c1.pk, n1.pk)])
+        self.assertEqual([(a['correspondance'], a['antecedent'].pk) for a in l2.appuis_valides],
+                         [(c2.pk, n2.pk)])
+        self.assertTrue(l1.lecture_complete and l2.lecture_complete)
+        with self.assertRaises(svc.ErreurContexteLecture) as refus:
+            svc.appuis_dorigine(self.nc)
+        self.assertEqual(refus.exception.code, 'SOURCE_AMBIGUE')
