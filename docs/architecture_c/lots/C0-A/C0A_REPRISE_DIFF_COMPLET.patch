+    def _etat(self):
+        """L'état métier observable, comparé avant et après un refus ou une panne."""
+        from case_manager.models import AncrageCitation, ConfirmationAppui
+        return {
+            'noeuds': sorted(LibraryNode.objects.values_list(
+                'pk', 'document_id', 'path', 'numchild', 'item', 'content_type_id', 'object_id')),
+            'statements': sorted(Statement.objects.values_list('pk', 'text')),
+            'captures': sorted(VersionTexte.objects.values_list('pk', 'statement_id', 'empreinte')),
+            'archives': sorted(NoeudArchive.objects.values_list('pk', flat=True)),
+            'extremites': sorted(ExtremiteCorrespondance.objects.values_list(
+                'pk', 'noeud_id', 'archive_id')),
+            'correspondances': sorted(Correspondance.objects.values_list('pk', 'etat', 'traitement')),
+            'confirmations': sorted(ConfirmationAppui.objects.values_list('pk', 'noeud_id', 'etat')),
+            'ancrages': sorted(AncrageCitation.objects.values_list('pk', 'noeud_id')),
+        }
