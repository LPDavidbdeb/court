+    def test_panne_apres_la_seconde_archive_annule_tout(self):
+        from unittest.mock import patch
+        parent = self._bloc_relie()
+        original, appels = svc.archiver_noeud, []
+
+        def apres_seconde(noeud, **kwargs):
+            a = original(noeud, **kwargs)
+            appels.append(a)
+            if len(appels) == 2:
+                raise RuntimeError("panne simulée après la seconde archive")
+            return a
+        self._panne_http(parent, patch('document_manager.concordance.archiver_noeud',
+                                       side_effect=apres_seconde))
+
+    def test_panne_apres_le_repointage_annule_tout(self):
+        from unittest.mock import patch
+        parent = self._bloc_relie()
+        original = ExtremiteCorrespondance.save
+
+        def apres_repointage(extremite, *args, **kwargs):
+            original(extremite, *args, **kwargs)
+            raise RuntimeError("panne simulée après repointage")
+        self._panne_http(parent, patch.object(ExtremiteCorrespondance, 'save', apres_repointage))
+
+    def test_panne_apres_le_premier_retrait_annule_tout(self):
+        from contextlib import contextmanager
+        from django.db.models.signals import post_delete
+        parent = self._bloc_relie()
+
+        def premier_retrait(sender, instance, **kwargs):
+            raise RuntimeError("panne simulée après le premier retrait")
+
+        @contextmanager
+        def recepteur():
+            post_delete.connect(premier_retrait, sender=LibraryNode, dispatch_uid="c0a-panne")
+            try:
+                yield
+            finally:
+                post_delete.disconnect(sender=LibraryNode, dispatch_uid="c0a-panne")
+        self._panne_http(parent, recepteur())
+
