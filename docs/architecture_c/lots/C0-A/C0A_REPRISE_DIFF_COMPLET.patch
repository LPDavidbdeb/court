+def _contenus_non_admissibles():
+    """Les clés génériques qu'aucune édition de texte ni archive ne prend en charge."""
+    from email_manager.models import Quote as EmailQuote
+    from events.models import Event
+    herite, certifiee = _citations_synthetiques()
+    evenement = Event.objects.create(date="2015-01-01", explanation="contenu d'un autre type")
+    ct = ContentType.objects.get_for_model
+    return {
+        'citation HERITE': dict(content_type=ct(EmailQuote), object_id=herite.pk),
+        'citation PHRASE certifiée': dict(content_type=ct(EmailQuote), object_id=certifiee.pk),
+        'Event': dict(content_type=ct(Event), object_id=evenement.pk),
+        'Statement disparu': dict(content_type=ct(Statement), object_id=987654),
+        'clé partielle, type seul': dict(content_type=ct(Statement), object_id=None),
+        'clé partielle, objet seul': dict(content_type=None, object_id=876543),
