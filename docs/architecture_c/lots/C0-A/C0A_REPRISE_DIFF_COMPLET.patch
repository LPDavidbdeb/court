+class C0ARepriseConcurrence(TransactionTestCase):
+    """
+    Contre-épreuves à deux connexions PostgreSQL réelles (autre fil, validé aussitôt).
+
+    Elles éprouvent les gardes locales de C0-A ; elles ne prouvent ni une
+    sérialisation générale ni la fermeture de tous les rattachements (L1-A, L5).
+    """
+
+    def setUp(self):
+        self.schema = schema_acte()
+        self.source = faire_document("origine", schema=self.schema)
+        self.cible = faire_document("rédaction", schema=self.schema)
+        self.rs, self.rc = racine_de(self.source), racine_de(self.cible)
+        self.st = Statement.objects.create(text="texte partagé", is_user_created=True)
+        self.ns = ajouter(self.rs, self.source, "1", "", statement=self.st)
+        self.nc = ajouter(self.rc, self.cible, "1", "", statement=self.st)
+
+    def test_uc13_rattachement_intercale_a_l_ancien_statement_ne_voit_pas_son_texte_change(self):
+        # Le cas à risque : un Statement qui paraît privé au contrôle (une seule
+        # occurrence), auquel une autre connexion rattache une occurrence avant
+        # l'édition. Le profil ne l'écrit jamais : son texte ne peut pas changer.
+        from unittest.mock import patch
+        prive = ajouter(self.rc, self.cible, "2", "texte privé")
+        ancien = prive.content_object
+        autre = faire_document("autre rédaction", schema=self.schema)
+        racine_autre = racine_de(autre)
+        intercale = {}
+
+        def rattacher():
+            n = ajouter(LibraryNode.objects.get(pk=racine_autre.pk), autre, "9", "",
+                        statement=Statement.objects.get(pk=ancien.pk))
+            intercale['pk'] = n.pk
+
+        original, appels = VersionTexte.capter, []
+
+        def capter_apres_controle(statement, motif=""):
+            if not appels:  # après les contrôles, avant la création et le repointage
+                appels.append(True)
+                _dans_une_autre_connexion(rattacher)
+            return original(statement, motif=motif)
+        with patch.object(VersionTexte, 'capter', side_effect=capter_apres_controle):
+            nouveau = svc.detacher_pour_edition(LibraryNode.objects.get(pk=prive.pk),
+                                                "texte réécrit")
+        self.assertEqual(Statement.objects.get(pk=ancien.pk).text, "texte privé")
+        rattache = LibraryNode.objects.get(pk=intercale['pk'])
+        self.assertEqual((rattache.object_id, rattache.content_object.text),
+                         (ancien.pk, "texte privé"))
+        self.assertEqual(LibraryNode.objects.get(pk=prive.pk).object_id, nouveau.pk)
+        self.assertNotEqual(nouveau.pk, ancien.pk)
+
+    def _bloc(self):
+        parent = ajouter(self.rc, self.cible, "B", "parent")
+        e1 = ajouter(parent, self.cible, "B1", "enfant un")
+        e2 = ajouter(parent, self.cible, "B2", "enfant deux")
+        return LibraryNode.objects.get(pk=parent.pk), e1, e2
+
+    def _supprimer_avec_intercalage(self, parent, intercaler):
+        from unittest.mock import patch
+        original, appels = svc.archiver_noeud, []
+
+        def archiver_apres_controle(noeud, **kwargs):
+            if not appels:  # le bloc entier vient d'être contrôlé
+                appels.append(True)
+                _dans_une_autre_connexion(intercaler)
+            return original(noeud, **kwargs)
+        with patch('document_manager.concordance.archiver_noeud',
+                   side_effect=archiver_apres_controle):
+            with self.assertRaises(SuppressionRefusee):
+                svc.supprimer_occurrence(parent)
+
+    def test_uc14_decision_inseree_pendant_la_suppression_est_preservee(self):
+        from case_manager.models import ConfirmationAppui, EtatAppui
+        parent, e1, e2 = self._bloc()
+        self._supprimer_avec_intercalage(parent, lambda: ConfirmationAppui.objects.create(
+            noeud_id=e2.pk, etat=EtatAppui.SANS_APPUI, motif="décidé pendant la suppression"))
+        self.assertEqual(LibraryNode.objects.filter(pk__in=[parent.pk, e1.pk, e2.pk]).count(), 3)
+        self.assertTrue(ConfirmationAppui.objects.filter(noeud_id=e2.pk).exists())
+        self.assertFalse(NoeudArchive.objects.exists())
+
+    def test_uc14_occurrence_ajoutee_au_bloc_pendant_la_suppression_annule_tout(self):
+        parent, e1, e2 = self._bloc()
+        ajoutee = {}
+
+        def ajouter_au_bloc():
+            n = ajouter(LibraryNode.objects.get(pk=parent.pk), self.cible, "B3", "enfant tardif")
+            ajoutee['pk'] = n.pk
+        self._supprimer_avec_intercalage(parent, ajouter_au_bloc)
+        self.assertEqual(LibraryNode.objects.filter(
+            pk__in=[parent.pk, e1.pk, e2.pk, ajoutee['pk']]).count(), 4)
+        self.assertFalse(NoeudArchive.objects.exists())
+        self.assertEqual(LibraryNode.objects.get(pk=parent.pk).numchild, 3)
