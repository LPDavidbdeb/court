+def _dans_une_autre_connexion(fonction):
+    """Exécute `fonction` dans un autre fil, donc une autre connexion PostgreSQL validée aussitôt."""
+    import threading
+    from django.db import connection
+    erreurs = []
+
+    def cible():
+        try:
+            fonction()
+        except Exception as e:  # noqa: BLE001 — remontée au fil principal
+            erreurs.append(e)
+        finally:
+            connection.close()
+
+    fil = threading.Thread(target=cible)
+    fil.start()
+    fil.join()
+    if erreurs:
+        raise erreurs[0]
