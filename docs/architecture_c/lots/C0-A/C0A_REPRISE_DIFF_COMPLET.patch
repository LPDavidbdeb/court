+    def _bloc_relie(self):
+        parent, enfant, structure = self._bloc()
+        corr = svc.relier(self.source, self.cible, [self.ns], [enfant])
+        svc.confirmer_traitement(corr, TraitementEditorial.CONSERVE, motif="examiné")
