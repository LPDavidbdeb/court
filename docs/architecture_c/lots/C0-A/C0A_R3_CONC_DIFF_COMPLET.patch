+    def test_T12_release_du_savepoint_ne_libere_pas_T2_avant_le_commit_externe(self):
+        from unittest.mock import patch
+        parent, e1, e2 = self._bloc()
+        original = svc.supprimer_occurrence
+        obs, journal = {'T1': self.t1, 'essai': 'T12'}, []
+
+        def tracer(execute, sql, params, many, context):
+            if 'SAVEPOINT' in sql:
+                journal.append(sql)
+            return execute(sql, params, many, context)
+
+        def service_puis_attente(noeud, **kwargs):
+            resultat = original(noeud, **kwargs)       # savepoint du service relâché
+            obs['service_sp'] = journal[0]
+            obs['release_avant_T2'] = journal[-1]
+            obs['dans_la_transaction_externe'] = connection.in_atomic_block
+            t2 = _Concurrente(lambda: self._editer(e2.pk, "B2", "texte tardif")).demarrer()
+            obs.update(T2=t2.pid, t2=t2, blocage=_attendre_blocage(t2, self.t1))
+            obs['t2_terminee_avant_commit'] = t2.terminee
+            transaction.on_commit(lambda: obs.__setitem__('commit_T1', time.monotonic()))
+            return resultat
+        with patch('document_manager.concordance.supprimer_occurrence',
+                   side_effect=service_puis_attente), connection.execute_wrapper(tracer):
+            r = self._supprimer_http(parent)
+        t2 = obs.pop('t2').joindre()
+        self._exiger(not self._borne_atteinte(t2), "borne d'attente atteinte")
+        code, corps = t2.resultat
+        obs.update(T1_reponse=r.status_code, T2_reponse=code, T2_fin=t2.fin)
+        _observer(obs)
+        self.assertEqual((r.status_code, r.json()['status']), (200, 'success'))
+        self.assertSansReinsertion(parent.pk, e1.pk, e2.pk)
+        self.assertEqual((code, corps['status']), (403, 'error'),
+                         "G10 : T2 refuse la cible retirée, sans succès anticipé.")
+        self.assertTrue(obs['dans_la_transaction_externe'])
+        self.assertEqual(obs['release_avant_T2'],
+                         obs['service_sp'].replace('SAVEPOINT', 'RELEASE SAVEPOINT', 1),
+                         "le savepoint du service était relâché avant le départ de T2")
+        self.assertIsNotNone(obs['blocage'], "G04 : RELEASE SAVEPOINT a libéré la protection.")
+        self.assertIn(self.t1, obs['blocage']['bloquee_par'])
+        self.assertFalse(obs['t2_terminee_avant_commit'])
+        self.assertGreater(t2.fin, obs['commit_T1'], "T2 ne termine qu'après le COMMIT externe")
