+    def _supprimer_avec_intercalage(self, parent, intercaler):
+        """
+        T2 valide juste avant que T1 ne protège son bloc (ordre A de R3-CONC).
+
+        Reprise R3-CONC — remplace l'intercalation dans `archiver_noeud`. Ancien
+        point : après le précontrôle, avant la première archive. Sous R3-CONC, T1 y
+        tient déjà ses verrous : T2 y attendrait la fin de T1, qui attendrait T2.
+        Ce cas-là est l'ordre B, éprouvé par `C0AR3Concurrence`. Nouveau point : la
+        requête de protection de T1, ou, sans elle, sa première archive — le dernier
+        instant où T1 n'a rien protégé ni écrit.
+        """
+        point = _PointSQL(_avant_protection, lambda: _dans_une_autre_connexion(intercaler))
+        with connection.execute_wrapper(point):
+            with self.assertRaises(SuppressionRefusee) as refus:
+                svc.supprimer_occurrence(parent)
+        if not point.atteint:
+            raise EssaiNonConcluant("Point « avant protection » non atteint.")
+        return str(refus.exception)
