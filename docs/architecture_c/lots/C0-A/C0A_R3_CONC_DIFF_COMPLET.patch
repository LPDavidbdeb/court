+    def _interblocage(self, delai_avant_inversion):
+        """
+        T1 (HTTP) protège rc, P, E1 puis attend E2, tenue par un écrivain étranger
+        qui, ensuite, veut rc : ordre inverse, interblocage réel. PostgreSQL choisit
+        la victime ; l'essai l'identifie par son SQLSTATE et vérifie les deux issues.
+        """
+        parent, e1, e2 = self._bloc()
+        tient, sql_t1, appels = threading.Event(), [], []
+        t1_pid = self.t1
+
+        def ecrivain_etranger():
+            with transaction.atomic():
+                n = LibraryNode.objects.get(pk=e2.pk)
+                n.item = "écrit par l'étranger"
+                n.save(update_fields=['item'])            # tient E2
+                tient.set()
+                limite = time.monotonic() + BORNE_S
+                while True:
+                    with connection.cursor() as c:
+                        c.execute("SELECT pg_blocking_pids(%s)", [t1_pid])
+                        if _pid_courant() in c.fetchone()[0]:
+                            break
+                    if time.monotonic() > limite:
+                        raise EssaiNonConcluant("T1 jamais bloquée par l'étranger")
+                    time.sleep(0.02)
+                time.sleep(delai_avant_inversion)
+                racine = LibraryNode.objects.get(pk=self.rc.pk)
+                racine.item = "Racine écrite par l'étranger"
+                racine.save(update_fields=['item'])       # veut rc : ordre inverse
+
+        def tracer(execute, sql, params, many, context):
+            try:
+                return execute(sql, params, many, context)
+            except Exception as e:
+                sql_t1.append(getattr(e.__cause__, 'pgcode', None))
+                raise
+        original = svc.supprimer_occurrence
+
+        def compter(*a, **kw):
+            appels.append(1)
+            return original(*a, **kw)
+        from unittest.mock import patch
+        etranger = _Concurrente(ecrivain_etranger, nom="étranger").demarrer()
+        self._exiger(tient.wait(BORNE_S), "l'étranger ne tient pas E2")
+        with patch('document_manager.concordance.supprimer_occurrence', side_effect=compter), \
+                connection.execute_wrapper(tracer):
+            r = self._supprimer_http(parent)
+        etranger.joindre()
+        if isinstance(etranger.erreur, EssaiNonConcluant):
+            raise etranger.erreur
+        code_etranger = getattr(getattr(etranger.erreur, '__cause__', None), 'pgcode', None)
+        obs = {'essai': 'T18', 'delai_s': delai_avant_inversion, 'T1': self.t1,
+               'etranger': etranger.pid, 'T1_reponse': r.status_code,
+               'T1_sqlstate': sql_t1, 'etranger_sqlstate': code_etranger, 'appels_T1': len(appels)}
+        _observer(obs)
+        victimes = [n for n, code in (("T1", '40P01' if '40P01' in sql_t1 else None),
+                                      ("étranger", code_etranger)) if code == '40P01']
+        self.assertEqual(len(victimes), 1, f"un interblocage réel, une seule victime : {obs}")
+        self.assertEqual(len(appels), 1, "aucune reprise cachée de T1")
+        return victimes[0], r, parent, e1, e2
+
+    def test_T18a_interblocage_victime_l_ecrivain_etranger(self):
+        victime, r, parent, e1, e2 = self._interblocage(delai_avant_inversion=1.5)
+        self.assertEqual(victime, "étranger")
+        self.assertEqual((r.status_code, r.json()['status']), (200, 'success'))
+        self.assertEqual(LibraryNode.objects.get(pk=self.rc.pk).item, "Racine",
+                         "rollback intégral de la victime")
