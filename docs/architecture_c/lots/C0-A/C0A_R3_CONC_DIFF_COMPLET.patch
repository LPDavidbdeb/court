+def _dans_une_autre_connexion(fonction):
+    """Exécute `fonction` dans un autre fil, donc une autre connexion PostgreSQL validée aussitôt."""
+    import threading
+    from django.db import connection
+    erreurs = []
+
+    def cible():
+        try:
+            fonction()
+        except Exception as e:  # noqa: BLE001 — remontée au fil principal
+            erreurs.append(e)
+        finally:
+            connection.close()
+
+    fil = threading.Thread(target=cible, daemon=True)
+    fil.start()
+    fil.join(BORNE_S)
+    if fil.is_alive():  # R3-CONC : une attente sans fin n'est jamais un résultat
+        raise EssaiNonConcluant(f"Connexion concurrente toujours active après {BORNE_S} s.")
+    if erreurs:
+        raise erreurs[0]
+
+
+# ---------------------------------------------------------------------------
+# R3-CONC — harnais à deux connexions PostgreSQL (UC-C-14)
+#
+# LES POINTS D'INTERCALATION SONT DES REQUÊTES SQL DE T1, observées par
+# `connection.execute_wrapper` puis exécutées telles quelles, avec leurs
+# paramètres : aucune garde n'est remplacée. Ils existent dans la version
+# antérieure comme dans la version corrigée ; le même essai s'exécute sur les deux.
+#
+# T2 s'exécute dans un autre fil, donc sur une autre connexion. Son attente est
+# CONSTATÉE dans PostgreSQL (`pg_blocking_pids`, `pg_locks`), puis maintenue
+# au-delà de `deadlock_timeout` pour que le journal du serveur la consigne
+# (`log_lock_waits`). Toute attente est bornée : une borne atteinte rend l'essai
+# NON CONCLUANT, jamais réussi. Les assertions de contrat précèdent les autres :
+# c'est par elles, et non par le harnais, qu'une version non conforme échoue.
+# ---------------------------------------------------------------------------
+
+BORNE_S = 20.0
+MAINTIEN_S = 1.2  # au-delà de deadlock_timeout (1 s)
+
+
+class EssaiNonConcluant(Exception):
+    """L'entrelacement demandé n'a pas été obtenu : ni succès, ni violation du contrat."""
+
+
+def _pid_courant():
+    with connection.cursor() as c:
+        c.execute("SELECT pg_backend_pid()")
+        return c.fetchone()[0]
+
+
+def _observer(obs):
+    """Consigne l'essai dans le journal de tests : PID, attentes, états, issues."""
+    print("R3_OBSERVATION " + json.dumps(obs, ensure_ascii=False, default=str), flush=True)
+
+
+class _Concurrente:
+    """Une transaction concurrente, dans un autre fil donc sur une autre connexion."""
+
+    def __init__(self, fonction, nom="T2"):
+        self.fonction, self.nom = fonction, nom
+        self.pid = self.resultat = self.erreur = self.fin = None
+        self._prete, self._finie = threading.Event(), threading.Event()
+        self._fil = threading.Thread(target=self._executer, daemon=True)
+
+    def _executer(self):
+        try:
+            with connection.cursor() as c:
+                c.execute("SET lock_timeout = %s", [f"{int(BORNE_S * 1000)}ms"])
+            self.pid = _pid_courant()
+            self._prete.set()
+            self.resultat = self.fonction()
+        except BaseException as e:  # noqa: BLE001 — rendue au fil principal
+            self.erreur = e
+        finally:
+            self.fin = time.monotonic()
+            self._prete.set()
+            self._finie.set()
+            connection.close()
+
+    def demarrer(self):
+        self._fil.start()
+        if not self._prete.wait(BORNE_S):
+            raise EssaiNonConcluant(f"{self.nom} n'a pas démarré.")
+        return self
+
+    @property
+    def terminee(self):
+        return self._finie.is_set()
+
+    def joindre(self):
+        self._fil.join(BORNE_S)
+        if self._fil.is_alive():
+            raise EssaiNonConcluant(f"{self.nom} toujours active après {BORNE_S} s.")
+        return self
+
+    def executer(self):
+        """Démarrer et attendre la fin : T2 valide avant que T1 ne reprenne."""
+        return self.demarrer().joindre()
+
+
+def _attendre_blocage(t2, par_pid, maintien=MAINTIEN_S):
+    """
+    Constate dans PostgreSQL que `t2` est bloquée par `par_pid`, l'y maintient,
+    puis rend le relevé. None si `t2` s'est terminée sans jamais attendre.
+    Interroge depuis la connexion du fil courant.
+    """
+    limite = time.monotonic() + BORNE_S
+    while True:
+        if t2.terminee:
+            return None
+        with connection.cursor() as c:
+            c.execute("SELECT pg_blocking_pids(%s)", [t2.pid])
+            if par_pid in c.fetchone()[0]:
+                break
+        if time.monotonic() > limite:
+            raise EssaiNonConcluant(f"{t2.nom} ni terminée ni bloquée par {par_pid}.")
+        time.sleep(0.02)
+    time.sleep(maintien)
+    with connection.cursor() as c:
+        c.execute("SELECT pg_blocking_pids(%s)", [t2.pid])
+        bloquants = c.fetchone()[0]
+        c.execute("SELECT pg_stat_clear_snapshot()")
+        c.execute("SELECT wait_event_type, wait_event FROM pg_stat_activity WHERE pid = %s",
+                  [t2.pid])
+        attente = c.fetchone()
+        c.execute(
+            "SELECT locktype, mode, granted, COALESCE(relation::regclass::text, ''),"
+            " COALESCE(page::text, ''), COALESCE(tuple::text, ''),"
+            " COALESCE(transactionid::text, '') FROM pg_locks WHERE pid = %s"
+            " ORDER BY granted, locktype", [t2.pid])
+        verrous = c.fetchall()
+    return {'pid': t2.pid, 'bloquee_par': list(bloquants), 'attente': list(attente or ()),
+            'verrous': [list(v) for v in verrous], 'maintenue_s': maintien}
+
+
+def _transaction_de(pid):
+    """La transaction de `pid` et les verrous lourds qu'elle détient, relevés dans pg_locks."""
+    with connection.cursor() as c:
+        c.execute(
+            "SELECT locktype, mode, COALESCE(relation::regclass::text, ''),"
+            " COALESCE(transactionid::text, '') FROM pg_locks WHERE pid = %s AND granted"
+            " AND locktype IN ('transactionid', 'relation') ORDER BY 1, 3", [pid])
+        return [list(v) for v in c.fetchall()]
+
+
+class _PointSQL:
+    """
+    Exécute `action` dans la connexion de T1 juste avant la première requête qui
+    satisfait `predicat` ; la requête originale part ensuite, inchangée.
+    """
+
+    def __init__(self, predicat, action):
+        self.predicat, self.action, self.atteint = predicat, action, False
+
+    def __call__(self, execute, sql, params, many, context):
+        if not self.atteint and self.predicat(sql, params):
+            self.atteint = True
+            self.action()
+        return execute(sql, params, many, context)
+
+
+def _avant_protection(sql, params):
+    """
+    Le dernier instant où T1 n'a rien protégé ni écrit : sa requête de protection
+    des occurrences (R3-CONC) ou, dans une version qui n'en a pas, sa première archive.
+    """
+    return (sql.startswith('INSERT INTO "document_manager_noeudarchive"')
+            or (sql.startswith('SELECT') and ' FOR UPDATE' in sql
+                and 'FROM "document_manager_librarynode"' in sql))
+
+
+def _avant_premiere_archive(sql, params):
+    return sql.startswith('INSERT INTO "document_manager_noeudarchive"')
+
+
+def _avant_delete(pk):
+    """Après la garde `pre_delete` de `pk`, juste avant le DELETE SQL qui le retire."""
+    def predicat(sql, params):
+        return (sql.startswith('DELETE FROM "document_manager_librarynode"')
+                and pk in (params or ()))
+    return predicat
+
+
+def _etat_en_base(pk):
+    """
+    L'occurrence telle que la base la porte à cet instant, vue par la connexion
+    courante, avec le texte qu'elle désigne : à l'instant du DELETE, c'est
+    l'état effectivement retiré.
+    """
+    ct = ContentType.objects.get_for_model(Statement).pk
+    with connection.cursor() as c:
+        c.execute(
+            'SELECT n.document_id, n.path, n.depth, n.item, n.paragraph_number,'
+            ' n.content_type_id, n.object_id, s.text'
+            ' FROM document_manager_librarynode n'
+            ' LEFT JOIN document_manager_statement s'
+            '   ON n.content_type_id = %s AND s.id = n.object_id'
+            ' WHERE n.id = %s', [ct, pk])
+        return c.fetchone()
