+class _PointSQL:
+    """
+    Exécute `action` dans la connexion de T1 juste avant la première requête qui
+    satisfait `predicat` ; la requête originale part ensuite, inchangée.
+    """
+
+    def __init__(self, predicat, action):
+        self.predicat, self.action, self.atteint = predicat, action, False
+
+    def __call__(self, execute, sql, params, many, context):
+        if not self.atteint and self.predicat(sql, params):
+            self.atteint = True
+            self.action()
+        return execute(sql, params, many, context)
+
+
+def _avant_protection(sql, params):
+    """
+    Le dernier instant où T1 n'a rien protégé ni écrit : sa requête de protection
+    des occurrences (R3-CONC) ou, dans une version qui n'en a pas, sa première archive.
+    """
+    return (sql.startswith('INSERT INTO "document_manager_noeudarchive"')
+            or (sql.startswith('SELECT') and ' FOR UPDATE' in sql
+                and 'FROM "document_manager_librarynode"' in sql))
+
+
+def _avant_premiere_archive(sql, params):
+    return sql.startswith('INSERT INTO "document_manager_noeudarchive"')
+
+
+def _avant_delete(pk):
+    """Après la garde `pre_delete` de `pk`, juste avant le DELETE SQL qui le retire."""
+    def predicat(sql, params):
+        return (sql.startswith('DELETE FROM "document_manager_librarynode"')
+                and pk in (params or ()))
+    return predicat
+
+
+def _etat_en_base(pk):
+    """
+    L'occurrence telle que la base la porte à cet instant, vue par la connexion
+    courante, avec le texte qu'elle désigne : à l'instant du DELETE, c'est
+    l'état effectivement retiré.
+    """
+    ct = ContentType.objects.get_for_model(Statement).pk
+    with connection.cursor() as c:
+        c.execute(
+            'SELECT n.document_id, n.path, n.depth, n.item, n.paragraph_number,'
+            ' n.content_type_id, n.object_id, s.text'
+            ' FROM document_manager_librarynode n'
+            ' LEFT JOIN document_manager_statement s'
+            '   ON n.content_type_id = %s AND s.id = n.object_id'
+            ' WHERE n.id = %s', [ct, pk])
+        return c.fetchone()
+
+
+def _etat_metier():
+    """L'état métier observable, comparé avant et après un refus, une panne ou une course."""
+    from case_manager.models import AncrageCitation, ConfirmationAppui
+    from email_manager.models import Quote as EmailQuote
