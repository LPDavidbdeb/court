+    def _supprimer_http(self, noeud):
+        from django.urls import reverse
+        return self.client.post(reverse("document_manager:ajax_delete_node", args=[noeud.pk]))
+
+    def _compteurs(self):
+        return (Statement.objects.count(), VersionTexte.objects.count(),
+                NoeudArchive.objects.count())
+
+    @staticmethod
+    def _exiger(condition, message):
+        if not condition:
+            raise EssaiNonConcluant(message)
+
+    @staticmethod
+    def _borne_atteinte(t2):
+        """Une attente coupée par lock_timeout est une limite du banc, pas une issue."""
+        texte = repr(t2.erreur) + repr(t2.resultat)
+        return 'lock timeout' in texte or 'canceling statement' in texte
+
+    # --- les deux ordres, par un seul intercalateur chacun ---
+
+    def _avant_protection_de(self, racine, t2_fonction):
+        """Ordre A : T2 s'exécute et VALIDE juste avant la protection effective de T1."""
+        obs = {'T1': self.t1}
+
+        def intercaler():
+            t2 = _Concurrente(t2_fonction).executer()
+            obs.update(T2=t2.pid, t2=t2)
+        point = _PointSQL(_avant_protection, intercaler)
+        with connection.execute_wrapper(point):
+            resultat, refus = self._supprimer(racine)
+        self._exiger(point.atteint, "Point « avant protection » non atteint.")
+        t2 = obs.pop('t2')
+        if t2.erreur is not None:
+            raise EssaiNonConcluant(f"T2 devait valider avant T1 : {t2.erreur!r}")
+        obs['refus_T1'] = str(refus) if refus else None
+        return resultat, refus, t2.resultat, obs
+
+    def _apres_garde(self, racine, cible, t2_fonction, t1=None, suite=None):
+        """
+        Ordre B tardif : T1 a passé la garde `pre_delete` de `cible` ; juste avant
+        son DELETE SQL, T2 démarre. T1 reprend dès que T2 est constatée bloquée
+        par elle — ou terminée sans attendre, ce que seule une version non
+        conforme permet. `suite` s'exécute alors, encore dans T1 (une panne, par
+        exemple).
+        """
+        obs = {'T1': self.t1}
+
+        def intercaler():
+            try:
+                t2 = _Concurrente(t2_fonction).demarrer()
+                obs.update(T2=t2.pid, t2=t2)
+                obs['blocage'] = _attendre_blocage(t2, self.t1)
+                obs['transaction_T1'] = _transaction_de(self.t1)
+                obs['etat_retire'] = _etat_en_base(cible.pk)
+            except EssaiNonConcluant as e:  # une vue la convertirait en 500
+                obs['non_concluant'] = e
+                raise
+            if suite is not None:
+                suite()
+        point = _PointSQL(_avant_delete(cible.pk), intercaler)
+        with connection.execute_wrapper(point):
+            issue = (t1 or self._supprimer)(racine)
+        self._exiger(point.atteint, "Point « après garde, avant DELETE » non atteint.")
+        if 'non_concluant' in obs:
+            raise obs['non_concluant']
+        t2 = obs.pop('t2').joindre()
+        self._exiger(not self._borne_atteinte(t2), f"borne d'attente atteinte : {t2.erreur!r}")
+        obs.update(T2_resultat=t2.resultat, T2_erreur=repr(t2.erreur) if t2.erreur else None)
+        return issue, t2, obs
