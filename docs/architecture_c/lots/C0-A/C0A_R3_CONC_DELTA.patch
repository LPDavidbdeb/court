+def _pid_courant():
+    with connection.cursor() as c:
+        c.execute("SELECT pg_backend_pid()")
+        return c.fetchone()[0]
+
+
+def _observer(obs):
+    """Consigne l'essai dans le journal de tests : PID, attentes, états, issues."""
+    print("R3_OBSERVATION " + json.dumps(obs, ensure_ascii=False, default=str), flush=True)
+
+
+class _Concurrente:
+    """Une transaction concurrente, dans un autre fil donc sur une autre connexion."""
+
+    def __init__(self, fonction, nom="T2"):
+        self.fonction, self.nom = fonction, nom
+        self.pid = self.resultat = self.erreur = self.fin = None
+        self._prete, self._finie = threading.Event(), threading.Event()
+        self._fil = threading.Thread(target=self._executer, daemon=True)
+
+    def _executer(self):
+        try:
+            with connection.cursor() as c:
+                c.execute("SET lock_timeout = %s", [f"{int(BORNE_S * 1000)}ms"])
+            self.pid = _pid_courant()
+            self._prete.set()
+            self.resultat = self.fonction()
+        except BaseException as e:  # noqa: BLE001 — rendue au fil principal
+            self.erreur = e
+        finally:
+            self.fin = time.monotonic()
+            self._prete.set()
+            self._finie.set()
+            connection.close()
+
+    def demarrer(self):
+        self._fil.start()
+        if not self._prete.wait(BORNE_S):
+            raise EssaiNonConcluant(f"{self.nom} n'a pas démarré.")
+        return self
+
+    @property
+    def terminee(self):
+        return self._finie.is_set()
+
+    def joindre(self):
+        self._fil.join(BORNE_S)
+        if self._fil.is_alive():
+            raise EssaiNonConcluant(f"{self.nom} toujours active après {BORNE_S} s.")
+        return self
+
+    def executer(self):
+        """Démarrer et attendre la fin : T2 valide avant que T1 ne reprenne."""
+        return self.demarrer().joindre()
+
+
+def _attendre_blocage(t2, par_pid, maintien=MAINTIEN_S):
+    """
+    Constate dans PostgreSQL que `t2` est bloquée par `par_pid`, l'y maintient,
+    puis rend le relevé. None si `t2` s'est terminée sans jamais attendre.
+    Interroge depuis la connexion du fil courant.
+    """
+    limite = time.monotonic() + BORNE_S
+    while True:
+        if t2.terminee:
+            return None
+        with connection.cursor() as c:
+            c.execute("SELECT pg_blocking_pids(%s)", [t2.pid])
+            if par_pid in c.fetchone()[0]:
