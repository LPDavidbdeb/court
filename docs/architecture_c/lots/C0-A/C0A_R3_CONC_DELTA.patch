+class C0AR3SauvegardeExistante(_BaseR3):
+    """R3-CONC T07, T08, T23 — aucune réinsertion par une instance périmée ; création neuve conservée."""
+
+    def test_T07_ancienne_instance_sauvegardee_sans_update_fields_ne_recree_pas(self):
+        """Discriminant contre f35ec85 : Django y bascule de l'UPDATE vers un INSERT."""
+        parent, e1, e2 = self._bloc()
+        anciennes = [LibraryNode.objects.get(pk=n.pk) for n in (e2, e1, parent)]
+        svc.supprimer_occurrence(parent)          # validée
+        archives = _etat_metier()['archives']
+        for n in anciennes:
+            n.item = "réécrit après le retrait"
+            try:
+                n.save()
+                erreur = None
+            except Exception as e:  # noqa: BLE001 — le type est vérifié ci-dessous
+                erreur = e
+            _observer({'essai': 'T07', 'noeud': n.pk, 'erreur': repr(erreur)})
+            self.assertSansReinsertion(n.pk)
+            self.assertIsInstance(erreur, ModificationRefusee)
+        self.assertEqual(_etat_metier()['archives'], archives, "archives inchangées")
+
+    def test_T08_update_fields_et_force_insert_refuses_sans_reinsertion(self):
+        parent, e1, e2 = self._bloc()
+        retiree, vivante = LibraryNode.objects.get(pk=e2.pk), LibraryNode.objects.get(pk=e1.pk)
+        svc.supprimer_occurrence(LibraryNode.objects.get(pk=e2.pk))
+        for libelle, n, appel in (
+                ("update_fields après retrait", retiree,
+                 lambda n: n.save(update_fields=['item'])),
+                ("force_insert après retrait", retiree, lambda n: n.save(force_insert=True)),
+                ("force_insert sur ligne vivante", vivante, lambda n: n.save(force_insert=True))):
+            with self.subTest(libelle):
+                # chaque variante part de l'état courant : un échec n'en contamine pas une autre
+                avant = _etat_metier()
+                n.item = "écriture refusée"
+                try:
+                    with transaction.atomic():
+                        appel(n)
+                    erreur = None
+                except Exception as e:  # noqa: BLE001 — le type est vérifié ci-dessous
+                    erreur = e
+                _observer({'essai': 'T08', 'variante': libelle, 'erreur': repr(erreur)})
+                if n is retiree:
+                    self.assertSansReinsertion(e2.pk)
+                self.assertEqual(_etat_metier(), avant, "aucun ancien PK réinséré, rien modifié")
+                self.assertIsInstance(erreur, ModificationRefusee, "refus propre, de domaine")
+
+    def test_T23_creation_treebeard_neuve_et_sauvegarde_existante_conservees(self):
+        avant = LibraryNode.objects.count()
+        enfants = LibraryNode.objects.get(pk=self.rc.pk).numchild
+        enfant = ajouter(LibraryNode.objects.get(pk=self.rc.pk), self.cible, "2", "nouvel enfant")
+        soeur = enfant.add_sibling('last-sibling', document=self.cible, item="3")
+        racine = LibraryNode.add_root(document=faire_document("autre"), item="Racine")
+        self.assertEqual(LibraryNode.objects.count(), avant + 3, "insertions neuves Treebeard")
+        self.assertEqual(LibraryNode.objects.get(pk=self.rc.pk).numchild, enfants + 2)
+        enfant.item = "2-bis"
+        enfant.save()
+        enfant.paragraph_number = "2"
+        enfant.save(update_fields=['paragraph_number'])
+        racine.item = "Racine-bis"
+        racine.save()
+        self.assertEqual((LibraryNode.objects.get(pk=enfant.pk).item,
+                          LibraryNode.objects.get(pk=enfant.pk).paragraph_number,
