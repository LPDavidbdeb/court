+        def service_puis_attente(noeud, **kwargs):
+            resultat = original(noeud, **kwargs)       # savepoint du service relâché
+            obs['service_sp'] = journal[0]
+            obs['release_avant_T2'] = journal[-1]
+            obs['dans_la_transaction_externe'] = connection.in_atomic_block
+            t2 = _Concurrente(lambda: self._editer(e2.pk, "B2", "texte tardif")).demarrer()
+            obs.update(T2=t2.pid, t2=t2, blocage=_attendre_blocage(t2, self.t1))
+            obs['t2_terminee_avant_commit'] = t2.terminee
+            transaction.on_commit(lambda: obs.__setitem__('commit_T1', time.monotonic()))
+            return resultat
+        with patch('document_manager.concordance.supprimer_occurrence',
+                   side_effect=service_puis_attente), connection.execute_wrapper(tracer):
+            r = self._supprimer_http(parent)
+        t2 = obs.pop('t2').joindre()
+        self._exiger(not self._borne_atteinte(t2), "borne d'attente atteinte")
