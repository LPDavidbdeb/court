}
entity "M2M Correspondance_versions_cible_examinees\ndocument_manager_correspondance_versions_cible_examinees" as E_document_manager_Correspondance_versions_cible_examinees <<M2M auto>> #FFF4E0 {
  {field} * id : BigAuto <<PK>>
